{
  "name": "GEFINA",
  "version": "0.2.0",
  "description": "Sistema de gestão de conta a receber.",
  "author": "Ruan Gabriel",
  "scripts": {
    "check": "tsc --noEmit && npx @biomejs/biome check ./",
    "fix": "biome check --write ./",
    "fix:unsafe": "biome check --write --unsafe ./",
    "test:api": "npm test --prefix ./api"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
